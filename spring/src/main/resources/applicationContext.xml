
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 등록된 Advisor를 찾아 포인트컷에 맞는 빈을 자동으로 프록시로 감싼다. -->
    <bean class="org.springframework.aop.framework.autoproxy.DefaultAdvisorAutoProxyCreator"/>

    <!-- 6-44: 타깃에 의존하지 않는 트랜잭션 어드바이스를 등록한다. -->
    <bean id="transactionAdvice" class="org.example2.Dao.TransactionAdvice">
        <property name="transactionManager" ref="transactionManager"/>
    </bean>

    <!-- 6-52: ServiceImpl로 끝나는 클래스의 upgrade* 메소드에만 트랜잭션을 적용한다. -->
    <bean id="transactionPointcut" class="org.example2.Dao.NameMatchClassMethodPointcut">
        <property name="mappedClassName" value="*ServiceImpl"/>
        <property name="mappedName" value="upgrade*"/>
    </bean>

    <!-- 6-46: 어드바이스와 적용 대상을 선정하는 포인트컷을 묶는다. -->
    <bean id="transactionAdvisor" class="org.springframework.aop.support.DefaultPointcutAdvisor">
        <property name="advice" ref="transactionAdvice"/>
        <property name="pointcut" ref="transactionPointcut"/>
    </bean>

    <!-- 6-53: 구현체를 직접 등록하면 조회하거나 DI 받을 때 자동 생성된 프록시가 전달된다. -->
    <bean id="userService" class="org.example2.Dao.UserServiceImpl">
        <property name="userDao" ref="userDao"/>
        <property name="userLevelUpgradePolicy" ref="userLevelUpgradePolicy"/>
        <property name="mailSender" ref="mailSender"/>
        <property name="mailFrom" value="noreply@example.com"/>
    </bean>

    <!-- CoreService의 전체 메소드에 적용하던 트랜잭션도 같은 어드바이스와 자동 프록시로 유지한다. -->
    <bean id="coreTransactionPointcut" class="org.example2.Dao.NameMatchClassMethodPointcut">
        <property name="mappedClassName" value="CoreServiceImpl"/>
        <property name="mappedName" value="*"/>
    </bean>

    <bean id="coreTransactionAdvisor" class="org.springframework.aop.support.DefaultPointcutAdvisor">
        <property name="advice" ref="transactionAdvice"/>
        <property name="pointcut" ref="coreTransactionPointcut"/>
    </bean>

    <bean id="coreService" class="org.example2.Dao.CoreServiceImpl">
        <property name="coreDao" ref="coreDao"/>
    </bean>

    <bean id="coreDao" class="org.example2.Dao.CoreDaoJdbc" init-method="initialize">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <bean id="mailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
        <property name="host" value="localhost"/>
        <property name="port" value="25"/>
        <property name="defaultEncoding" value="UTF-8"/>
    </bean>

    <bean id="transactionManager" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <bean id = "userLevelUpgradePolicy" class = "org.example2.Dao.DefaultUserLevelUpgradePolicy">
        <property name="userDao" ref="userDao"/>
    </bean>

    <bean id = "userDao" class = "org.example2.Dao.UserDaoJdbc" init-method = "initialize">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <bean id = "dataSource" class = "org.springframework.jdbc.datasource.SimpleDriverDataSource">
        <property name = "driverClass" value = "org.h2.Driver" />
        <property name = "url" value = "jdbc:h2:./springbook" />
        <property name = "username" value = "sa" />
        <property name = "password" value = "" />
    </bean>

    <bean id = "message"
        class="org.example2.Dao.MessageFactoryBean">
        <property name="text" value="Factory Bean" />
    </bean>

</beans>
